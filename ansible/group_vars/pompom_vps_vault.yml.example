---
# Template du Vault Ansible — copier puis chiffrer :
#   cp ansible/group_vars/pompom_vps_vault.yml.example ansible/group_vars/pompom_vps_vault.yml
#   # éditer les valeurs ci-dessous
#   ansible-vault encrypt ansible/group_vars/pompom_vps_vault.yml
#
# Éditer après chiffrement :
#   ansible-vault edit ansible/group_vars/pompom_vps_vault.yml
#
# Le vrai fichier pompom_vps_vault.yml est CHIFFRÉ puis committé (la CI en a
# besoin). Ne jamais y mettre de valeurs en clair non chiffrées. Ce .example
# ne sert que de gabarit documentaire (placeholders).

env_production: |
  # ---------- PostgreSQL ----------
  POSTGRES_USER=pompom
  # IMPORTANT : POSTGRES_PASSWORD doit être URL-safe (pas de / + = : @ espace).
  # Il est interpolé BRUT dans DATABASE_URL (postgresql://user:PASS@db:5432/...)
  # côté docker-compose.prod.yml : un caractère spécial casse le parsing
  # (Prisma P1013 "invalid port number"). Générer avec : openssl rand -hex 24
  POSTGRES_PASSWORD=REMPLACER_PAR_UN_MDP_HEX_URL_SAFE_openssl_rand_hex_24
  POSTGRES_DB=pompom

  # ---------- API ----------
  # JWT_SECRET : >= 48 caractères aléatoires — générer : openssl rand -base64 48
  JWT_SECRET=REMPLACER_openssl_rand_base64_48
  JWT_EXPIRES_IN=7d
  # CORS_ORIGIN : origines autorisées, séparées par des virgules (apex + www)
  CORS_ORIGIN=https://vergersdesabers.fr,https://www.vergersdesabers.fr
  MAX_UPLOAD_SIZE_MB=5

  # ---------- Admin initial ----------
  ADMIN_EMAIL=admin@vergersdesabers.fr
  ADMIN_PASSWORD=REMPLACER_mot_de_passe_admin_fort
  # ---------- Email transactionnel (Resend) ----------
  # Clé API depuis resend.com/api-keys (NE JAMAIS committer la vraie valeur)
  RESEND_API_KEY=re_REMPLACER_par_la_cle_resend
  CONTACT_EMAIL_TO=REMPLACER@exemple.fr
  CONTACT_EMAIL_FROM=contact@vergersdesabers.fr

  # ---------- Rate limiting ----------
  AUTH_LOGIN_RATE_LIMIT_MAX=5
  AUTH_LOGIN_RATE_LIMIT_WINDOW=1 minute

  # ---------- Front (build args Vite) ----------
  VITE_API_URL=https://api.vergersdesabers.fr
  VITE_PUBLIC_SITE_URL=https://vergersdesabers.fr
