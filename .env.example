# Variables d'environnement Pom'Pom — utilisées par docker-compose.yml ET docker-compose.prod.yml.
#
# DEV LOCAL : `docker compose up` fonctionne SANS .env (défauts intégrés au compose).
#             Crée un .env basé sur ce fichier UNIQUEMENT si tu veux override les défauts.
#
# PROD VPS OVH : .env OBLIGATOIRE. Toutes les vars marquées (requis-prod) doivent être définies.
#                Compose plantera explicitement si une var manque (pas de fallback).
#
# Copier : cp .env.example .env  puis remplir les valeurs

# ---------- PostgreSQL ----------
POSTGRES_USER=pompom
POSTGRES_PASSWORD=changeme_strong_password         # (requis-prod) générer un mot de passe fort
POSTGRES_DB=pompom

# ---------- API ----------
# (requis-prod) générer avec : openssl rand -base64 48
JWT_SECRET=changeme_minimum_48_chars_random_base64_string
JWT_EXPIRES_IN=7d

# (requis-prod) domaine du front en prod (CORS) — sépare plusieurs origines par virgule
CORS_ORIGIN=https://www.vergersdesabers.fr

MAX_UPLOAD_SIZE_MB=5

# Rate limiting du login admin (anti-brute-force) — défauts : 5 essais / 1 minute / IP
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW=1 minute

# ---------- Email transactionnel (Resend — formulaire de contact) ----------
# (requis-prod) clé API Resend — créer sur https://resend.com puis vérifier le domaine d'envoi
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Adresse qui reçoit les messages du formulaire de contact
CONTACT_EMAIL_TO=pom-pom@mailo.com
# Adresse expéditrice (doit appartenir au domaine vérifié dans Resend)
CONTACT_EMAIL_FROM=contact@pompom.fr

# ---------- Admin initial (utilisé par prisma:seed une fois) ----------
ADMIN_EMAIL=admin@pompom.fr
ADMIN_PASSWORD=changeme_strong_password            # (requis-prod) mot de passe fort

# ---------- Front ----------
# (requis-prod) URL publique de l'API en prod (utilisée à la build du front)
VITE_API_URL=https://api.pompom.fr

# URL publique du site front (utilisée pour le SEO / OG tags / sitemap.xml)
# Valeur prod par défaut ; overrider en dev si nécessaire
VITE_PUBLIC_SITE_URL=https://pompom.fr
