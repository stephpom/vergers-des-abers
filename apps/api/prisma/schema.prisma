generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String         @default("")
  published   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      ProductImage[]

  @@index([published])
}

model SalesPoint {
  id          String   @id @default(cuid())
  name        String
  address     String
  description String   @default("")
  latitude    Float?
  longitude   Float?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  filename  String
  alt       String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

enum PressingRate {
  WITH_BOTTLES
  WITHOUT_BOTTLES
}

model PressingSlot {
  id           String                @id @default(cuid())
  startsAt     DateTime              @unique
  capacityKg   Int                   @default(800)
  reservations PressingReservation[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([startsAt])
}

model PressingReservation {
  id         String       @id @default(cuid())
  slotId     String
  slot       PressingSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  firstName  String
  lastName   String
  phone      String
  quantityKg Int
  rate       PressingRate
  createdAt  DateTime     @default(now())

  @@index([slotId])
}

model PressingSettings {
  id        String   @id @default("main")
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
